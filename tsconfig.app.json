{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  // "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // `composite: true` requires every file in the program to be listed, so the
  // bundled translation dictionaries need an explicit pattern. Kept narrow on
  // purpose — a blanket src/**/*.json would pull the large story fixtures in.
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "src/i18n/*.json"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
